{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "ReadDeployFiles", "Effect": "Allow", "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::cinebook-artifacts-<ACCOUNT_ID>/db/*" },
    { "Sid": "ReadAppConfig", "Effect": "Allow", "Action": ["ssm:GetParameter", "ssm:GetParameters", "ssm:GetParametersByPath"],
      "Resource": "arn:aws:ssm:ap-south-1:<ACCOUNT_ID>:parameter/cinebook/prod/*" }
  ]
}
