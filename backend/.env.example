DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/moviebooking
APP_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HOLD_SECONDS=300
# Leave empty to serve the API at /; set /api when a proxy serves it under /api.
API_PREFIX=
# Phase 2: demo SMS (or set them with scripts\setup-demo-sms.ps1)
SMS_DEMO_NUMBERS=+919800000000
PUBLIC_SITE_URL=http://localhost:5173
DEMO_PHONE_ACCESS_CODE=CHANGE_ME
# Phase 3: chat assistant (check the key and model with scripts\check-gemini.py)
CHAT_PROVIDER=gemini
CHAT_MODEL_ID=gemini-3.5-flash-lite
GEMINI_API_KEY=CHANGE_ME

# Optional settings
# CANCEL_CUTOFF_MINUTES=120
# LOG_LEVEL=INFO
# API_WORKERS=2
# SENDER_EMAIL=cinebook@localhost
# REQUIRE_LOGIN_FOR_BOOKING=true

# Movie listings: free key from https://www.themoviedb.org/settings/api, then run .\scripts\import-movies.ps1
TMDB_API_KEY=
