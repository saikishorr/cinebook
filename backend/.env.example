DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/moviebooking
APP_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=*
DYNAMODB_TABLE=seat-holds
AWS_REGION=ap-south-1
HOLD_SECONDS=300
BOOKING_QUEUE_URL=https://sqs.<region>.amazonaws.com/<account-id>/<queue-name>.fifo
# Leave empty for local paths; set to /api in the cloud.
API_PREFIX=
# Phase 2: demo SMS (set real values with infra\scripts\setup-demo-sms.ps1)
SMS_DEMO_NUMBERS=+919800000000
PUBLIC_SITE_URL=http://localhost:5173
DEMO_PHONE_ACCESS_CODE=CHANGE_ME
# Phase 3: chat assistant (set real values with infra\scripts\check-gemini.py)
CHAT_PROVIDER=gemini
CHAT_MODEL_ID=gemini-3.5-flash-lite
GEMINI_API_KEY=CHANGE_ME

# Local mode (no AWS): uncomment these overrides.
# HOLDS_BACKEND=postgres
# QUEUE_BACKEND=inline
# EMAIL_BACKEND=log
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CANCEL_CUTOFF_MINUTES=120
# LOG_LEVEL=INFO
# API_WORKERS=2
# SES_SENDER_EMAIL=you@example.com

# Movie listings: free key from https://www.themoviedb.org/settings/api, then run .\scripts\import-movies.ps1
TMDB_API_KEY=
