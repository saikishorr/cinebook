{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "ReadBookingQueue", "Effect": "Allow",
      "Action": ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes", "sqs:ChangeMessageVisibility"],
      "Resource": "arn:aws:sqs:ap-south-1:<ACCOUNT_ID>:booking-requests.fifo" },
    { "Sid": "ReleaseSeatHolds", "Effect": "Allow",
      "Action": ["dynamodb:DeleteItem"],
      "Resource": "arn:aws:dynamodb:ap-south-1:<ACCOUNT_ID>:table/seat-holds" },
    { "Sid": "SendConfirmationEmail", "Effect": "Allow",
      "Action": ["ses:SendEmail"],
      "Resource": "arn:aws:ses:ap-south-1:<ACCOUNT_ID>:identity/*" },
    { "Sid": "ReadDatabaseSettings", "Effect": "Allow",
      "Action": ["ssm:GetParameters", "ssm:GetParameter"],
      "Resource": "arn:aws:ssm:ap-south-1:<ACCOUNT_ID>:parameter/cinebook/prod/db/*" }
  ]
}
