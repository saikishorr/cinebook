{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "SeatHolds", "Effect": "Allow",
      "Action": ["dynamodb:GetItem","dynamodb:PutItem","dynamodb:UpdateItem","dynamodb:DeleteItem","dynamodb:Query","dynamodb:ConditionCheckItem"],
      "Resource": ["arn:aws:dynamodb:ap-south-1:<ACCOUNT_ID>:table/seat-holds", "arn:aws:dynamodb:ap-south-1:<ACCOUNT_ID>:table/seat-holds/index/*"] },
    { "Sid": "BookingQueue", "Effect": "Allow",
      "Action": ["sqs:SendMessage","sqs:GetQueueAttributes"],
      "Resource": "arn:aws:sqs:ap-south-1:<ACCOUNT_ID>:booking-requests.fifo" },
    { "Sid": "ContainerLogs", "Effect": "Allow",
      "Action": ["logs:CreateLogStream","logs:PutLogEvents","logs:DescribeLogStreams"],
      "Resource": "arn:aws:logs:ap-south-1:<ACCOUNT_ID>:log-group:/cinebook/api:*" }
  ]
}
