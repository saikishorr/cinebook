{
  "widgets": [
    {
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 24,
      "height": 2,
      "properties": {
        "markdown": "# CineBook\nVisitors -> load balancer -> API server -> booking queue -> worker Lambda -> database, email and demo SMS. The API server also runs the chat assistant (Gemini API). Load balancer graphs use SEARCH, so they keep working after the load balancer is recreated."
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 2,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Load balancer: requests and errors",
        "region": "ap-south-1",
        "view": "timeSeries",
        "period": 300,
        "metrics": [
          [
            {
              "expression": "SEARCH('{AWS/ApplicationELB,LoadBalancer} MetricName=\"RequestCount\" cinebook', 'Sum', 300)",
              "id": "req",
              "label": "Requests"
            }
          ],
          [
            {
              "expression": "SEARCH('{AWS/ApplicationELB,LoadBalancer} MetricName=\"HTTPCode_Target_5XX_Count\" cinebook', 'Sum', 300)",
              "id": "t5xx",
              "label": "API 5xx"
            }
          ],
          [
            {
              "expression": "SEARCH('{AWS/ApplicationELB,LoadBalancer} MetricName=\"HTTPCode_ELB_5XX_Count\" cinebook', 'Sum', 300)",
              "id": "e5xx",
              "label": "Load balancer 5xx"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 2,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "API servers: healthy / unhealthy",
        "region": "ap-south-1",
        "view": "timeSeries",
        "period": 60,
        "metrics": [
          [
            {
              "expression": "SEARCH('{AWS/ApplicationELB,LoadBalancer,TargetGroup} MetricName=\"HealthyHostCount\" cinebook', 'Minimum', 60)",
              "id": "healthy",
              "label": "Healthy"
            }
          ],
          [
            {
              "expression": "SEARCH('{AWS/ApplicationELB,LoadBalancer,TargetGroup} MetricName=\"UnHealthyHostCount\" cinebook', 'Maximum', 60)",
              "id": "unhealthy",
              "label": "Unhealthy"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 8,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Booking worker (Lambda)",
        "region": "ap-south-1",
        "view": "timeSeries",
        "period": 300,
        "metrics": [
          [
            "AWS/Lambda",
            "Invocations",
            "FunctionName",
            "cinebook-confirm-booking",
            {
              "stat": "Sum"
            }
          ],
          [
            ".",
            "Errors",
            ".",
            ".",
            {
              "stat": "Sum"
            }
          ],
          [
            ".",
            "Duration",
            ".",
            ".",
            {
              "stat": "Average",
              "yAxis": "right",
              "label": "Duration (ms, right axis)"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 8,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Booking queue and dead-letter queue",
        "region": "ap-south-1",
        "view": "timeSeries",
        "period": 300,
        "metrics": [
          [
            "AWS/SQS",
            "NumberOfMessagesSent",
            "QueueName",
            "booking-requests.fifo",
            {
              "stat": "Sum",
              "label": "Bookings queued"
            }
          ],
          [
            ".",
            "ApproximateNumberOfMessagesVisible",
            ".",
            "booking-requests-dlq.fifo",
            {
              "stat": "Maximum",
              "label": "Dead-letter messages"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 14,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Database (RDS)",
        "region": "ap-south-1",
        "view": "timeSeries",
        "period": 300,
        "metrics": [
          [
            "AWS/RDS",
            "CPUUtilization",
            "DBInstanceIdentifier",
            "cinebook-db",
            {
              "stat": "Average",
              "label": "CPU %"
            }
          ],
          [
            ".",
            "DatabaseConnections",
            ".",
            ".",
            {
              "stat": "Maximum",
              "yAxis": "right",
              "label": "Connections (right axis)"
            }
          ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 12,
      "y": 14,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "API server CPU (EC2)",
        "region": "ap-south-1",
        "view": "timeSeries",
        "period": 300,
        "metrics": [
          [
            "AWS/EC2",
            "CPUUtilization",
            "AutoScalingGroupName",
            "cinebook-api-asg",
            {
              "stat": "Average",
              "label": "CPU %"
            }
          ]
        ]
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 20,
      "width": 24,
      "height": 6,
      "properties": {
        "title": "Latest booking confirmations (email and demo SMS) and problems",
        "region": "ap-south-1",
        "view": "table",
        "query": "SOURCE '/aws/lambda/cinebook-confirm-booking' | fields @timestamp, @message | filter @message like /CONFIRMED|Could not/ | sort @timestamp desc | limit 20"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 26,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Chat assistant: questions per hour",
        "region": "ap-south-1",
        "view": "bar",
        "query": "SOURCE '/cinebook/api' | filter @message like \"POST /api/chat-links/\" and @message like \"/messages\" | stats count() as questions by bin(1h)"
      }
    },
    {
      "type": "log",
      "x": 12,
      "y": 26,
      "width": 12,
      "height": 6,
      "properties": {
        "title": "Chat assistant: problems (model failures, limits reached, errors)",
        "region": "ap-south-1",
        "view": "table",
        "query": "SOURCE '/cinebook/api' | fields @timestamp, @message | filter @message like \"Chat model call failed\" or @message like /chat-links.*\" (429|500|503)/ | sort @timestamp desc | limit 20"
      }
    }
  ]
}
